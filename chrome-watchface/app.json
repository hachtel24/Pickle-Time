{
  "configVersion": "v3",
  "app": {
    "appId": 1000001,
    "appName": "Liquid Chrome",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "cover": ["preview.png"],
    "vender": "chachtel",
    "description": "Polished chrome digital face with steps, calories and battery."
  },
  "permissions": [],
  "runtime": {
    "apiVersion": {
      "compatible": "1.0.0",
      "target": "1.0.1",
      "minVersion": "1.0.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [{ "st": "r" }],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": { "appName": "Liquid Chrome" }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
